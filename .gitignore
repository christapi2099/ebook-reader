.uv-cache/
*.db
uploads/

# Node
node_modules/
.svelte-kit/
build/
dist/
.env

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
test-results/
playwright-report/
blob-report/
# Scratch output from test-timing runs.
.perfile_timing*.txt
backend/tests/.logs/

# Code intelligence / local tooling
.codegraph/

# Claude memory / scratch
.memory/
.opencode/deepseek_research.md
.opencode/glm_speed_analysis.md

# NOTE: docs/plans/ is intentionally COMMITTED. An earlier agent ignored it as
# local scratch, but the plans are the deliverable that implementers and reviewers
# are handed, and a plan that only exists on one machine cannot be the contract
# between three agents. Keep them in git.

# Agent safety-net snapshots (scripts/agent-safety.sh)
.snapshots/

# Scratch diagnostics written by agents (logs, captured runs, DB fingerprints)
.final_backend.txt
.full_run.txt
.slow_run.out
.stall_probe.txt
.db_before_full
.pw_install*.log
*_run.txt

# Per-agent worktrees (scripts/agent-worktree.sh)
.worktrees/

# Runtime voice directory: user uploads and converted .pt voices. Tests redirect
# VOICES_DIR into tmp_path, but test_voices_router.py uploads files named
# test_voice.pt / custom1.pt, and before that guard existed they were committed
# from here by accident (58a62a0).
backend/voices/

# Flake-hunt logs from the selective test runner
backend/flake*.log
