# ─────────────────────────────────────────────────────────────────────────────
# Kokoro reader backend configuration
#
# Copy to `.env` (which is git-ignored) and edit. Every variable below is
# optional: with no `.env` at all the backend runs exactly as it always has —
# local Kokoro, CPU or CUDA, no network required.
#
# Real environment variables win over this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Which synthesis backend to use ───────────────────────────────────────────
# local  (default) Run Kokoro in this process. Never touches the network.
# remote           Run Kokoro on the deployed Modal GPU. Falls back to local
#                  (with a loud warning) if the remote backend is unusable.
# auto             Probe Modal at startup and use it only when credentials exist
#                  AND the deployed app answers; otherwise run local.
KOKORO_BACKEND=local

# ── Modal credentials ────────────────────────────────────────────────────────
# Leave these unset to use the normal Modal profile in ~/.modal.toml (what
# `modal token new` writes). Set them only where that file is not available,
# e.g. inside a container. They are secrets: never commit them.
#MODAL_TOKEN_ID=
#MODAL_TOKEN_SECRET=
# Path to a non-default Modal config file (defaults to ~/.modal.toml).
#MODAL_CONFIG_PATH=

# ── Modal app identity (must match what you deployed) ────────────────────────
# These are read by BOTH the local client and `modal deploy`.
MODAL_KOKORO_APP_NAME=kokoro-tts
MODAL_KOKORO_FUNCTION_NAME=synthesize

# ── Modal client behaviour ───────────────────────────────────────────────────
# auto (default) → the Modal SDK when credentials exist, otherwise HTTP.
# sdk            → always the Modal SDK (`modal.Function.from_name(...).remote`).
# http           → always POST to MODAL_KOKORO_URL.
MODAL_KOKORO_TRANSPORT=auto

# Hard cap on one remote synthesis call. A cold start has to pull the image and
# load 327 MB of weights, so this is generous on purpose; without it a wedged
# call would stall the reader forever.
MODAL_KOKORO_TIMEOUT_SECONDS=300

# Public, torch-free liveness URL of the deployed app. When set, the
# reachability check in /api/system/capabilities uses this cheap GET instead of
# a Modal API round-trip. Printed by `modal deploy`.
#
# The URL is `<workspace>--<label>.modal.run`, where <label> is the `label=`
# passed to @modal.fastapi_endpoint in backend/modal_kokoro.py — that is
# `health`, so for the christapi2099 workspace it is exactly:
#   https://christapi2099--health.modal.run
# It is NOT derived from MODAL_KOKORO_APP_NAME: `--kokoro-tts-health` 404s.
#MODAL_KOKORO_HEALTH_URL=https://<workspace>--health.modal.run

# Synthesis URL — only needed when MODAL_KOKORO_TRANSPORT=http. Nothing in this
# deployment serves it: the app exposes only the CPU `health` endpoint on
# purpose, because a public GPU endpoint can be called by anyone who knows the
# URL and every call costs GPU time. The SDK transport (the default) is
# authenticated and has no such exposure, so it needs no URL at all.
#MODAL_KOKORO_URL=https://<workspace>--<label>.modal.run

# Kokoro language pipeline: 'a' American English, 'b' British English.
MODAL_KOKORO_LANG_CODE=a

# ── Modal deployment settings (read by `modal deploy`, not by the backend) ───
# Cost fallback list, chosen for cheapest cost per hour of *audio* rather than
# cheapest per hour of GPU (docs/research/kokoro-runtime-picks.md §4):
#   L4  $0.80/h  81x realtime  ->  ~$0.10 per 9-hour audiobook
#   A10 $1.10/h  96x realtime  ->  ~$0.12
#   T4  $0.59/h  36x realtime  ->  ~$0.18
# Modal takes the first GPU it can schedule, so listing L4 first prefers the
# cheapest-per-audio pick and still falls back to A10/T4 when L4 is busy. A
# pinned T4 costs more per hour of audio *and* is likelier to wait for capacity,
# which is why no region is pinned either. Comma-separated, in preference order.
MODAL_KOKORO_GPU=L4,A10,T4

# Modal Volume holding the Hugging Face cache, so cold containers read the
# weights locally instead of re-downloading ~355 MB.
MODAL_KOKORO_VOLUME_NAME=kokoro-hf-cache

# Seconds an idle GPU container stays warm before shutting down. Every second it
# is warm is billed; 60 s keeps the reader snappy between sentences without
# paying for an idle GPU all day. Idle time, not synthesis, is the real bill:
# an L4 kept warm permanently is ~$575/month.
MODAL_KOKORO_IDLE_SECONDS=60

# Alpha: Modal GPU memory snapshots can cut the ~10-20 s cold start to ~2-4 s,
# but the feature is still experimental. Off by default; the snapshot-free path
# is the supported one and keeps working whichever way this is set.
MODAL_KOKORO_GPU_SNAPSHOT=0

# How many requests one interactive container may handle at once. Kokoro handles
# one input at a time, so this overlaps container start-up and I/O rather than
# the forward pass (which is serialised by a lock inside the app).
MODAL_KOKORO_MAX_INPUTS=4

# ── Modal bulk export ────────────────────────────────────────────────────────
# The export path fans a book out over several containers, one chapter-sized
# batch each, and is compute-bound rather than idle-bound — so it optimises the
# opposite way from interactive reading: cheapest GPU per *synthesized hour*
# (L4), more containers at once, and an immediate scale-down because the next
# batch is already queued when one finishes.
MODAL_KOKORO_EXPORT_FUNCTION_NAME=synthesize_batch
MODAL_KOKORO_EXPORT_GPU=L4
MODAL_KOKORO_EXPORT_MAX_CONTAINERS=6
MODAL_KOKORO_EXPORT_IDLE_SECONDS=5
MODAL_KOKORO_EXPORT_TIMEOUT_SECONDS=1800

# How long a Settings switch to Modal keeps reporting starting/warming_up before
# it gives up and calls the engine ready anyway. Bounded so a warm-up that never
# answers cannot leave the UI spinning for ever.
KOKORO_WARMUP_WATCH_SECONDS=180

# ── Audio cache retention ────────────────────────────────────────────────────
# The synthesis cache is content-addressed and grows with everything you listen
# to. Nothing ever removed rows until now, and one slider drag adds ~50 rows
# (~9 MB). A sweep runs once at startup and then on a timer, deleting the OLDEST
# rows until the retained audio fits the cap.
#
# This is insertion-order (FIFO) eviction, not true LRU: created_at is written
# once and a cache hit does not touch the row, so a sentence you replay daily
# still looks as old as one you never played.
#
# Default is 4096 MB. The cache currently holds ~808 MB of audio in an ~840 MB
# file, so the default leaves roughly 5x headroom and cannot delete existing data
# on the first boot. Lower it to reclaim disk, but note that any cap below the
# current size will evict on the next sweep.
AUDIO_CACHE_MAX_MB=4096

# How often the periodic sweep runs, in seconds. It is cheap while under the cap
# (it compares the file size first, ~2 ms on the real database), so this can be
# frequent. A value of zero or less falls back to the default rather than to
# "evict everything".
AUDIO_CACHE_SWEEP_INTERVAL_SECONDS=900

# How each cached sentence is stored: `pcm16` (default) or `opus`.
#
# This compresses the cache *at rest* only. The WebSocket still carries WAV
# frames to the browser either way, because the client decodes every frame with
# `decodeAudioData` — whose Opus support is not universal — and because that
# transport is loopback, where a compressed frame buys nothing. See §5.5 of
# docs/TTS_ARCHITECTURE.md.
#
# `pcm16` is 48 000 bytes per audio-second, so the 4096 MB cap above holds
# roughly three books. `opus` stores each sentence as 24 kbps Ogg Opus instead
# and measured 15.2x smaller (a 5 s sentence: 240 000 -> 15 798 bytes), holding
# an order of magnitude more audio under the same cap, at the cost of ~13.5 ms of
# decode per 5 s sentence and some encoder CPU on the synthesis path.
#
# Off by default because the size win is certain but the quality trade is a
# listening judgement, and nothing here has measured it against your own corpus.
# Switching either way is safe: `AudioCache.codec` records what each row holds,
# so existing rows stay readable and no stored audio has to be rewritten. A row
# that cannot be decoded is re-synthesised rather than served.
#AUDIO_CACHE_CODEC=opus

# Deleting rows does not shrink the SQLite file: freed pages stay in it for
# reuse. Reclaiming them needs an explicit VACUUM, which rewrites the whole file
# (needs free space about equal to the file) and holds a write lock throughout,
# so it is deliberately never run automatically. cache_stats()["freelist_bytes"]
# reports what a VACUUM would return.

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL the Svelte app calls for the backend API. Read by the frontend build
# (Vite only exposes variables prefixed with VITE_).
VITE_API_BASE=http://localhost:8000
